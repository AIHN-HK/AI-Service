# ============================================
# Chatbot Service — Environment Variables
# ============================================
# Only SECRETS and infrastructure-specific vars go here.
# Non-sensitive config (DB names, TTLs, thresholds) lives in config/{env}.yaml.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── API Keys (Secrets) ────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── MongoDB ──────────────────────────────────
# Self-hosted (Docker internal):
MONGODB_URI=mongodb://root:rootpassword@chatbot_mongo:27017/chatbot_service?authSource=admin
KNOWLEDGE_MONGO_URI=mongodb://root:rootpassword@chatbot_mongo:27017/knowledge_ingestion?authSource=admin
MONGO_USER=root
MONGO_PASSWORD=rootpassword
# Cloud (MongoDB Atlas) — uncomment below and comment above:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatbot_service?retryWrites=true&w=majority
# KNOWLEDGE_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/knowledge_ingestion

# ── Redis (Infrastructure-specific) ──────────
# Use container name 'chatbot_redis' when running via docker-compose
REDIS_URL=redis://chatbot_redis:6379

# ── Qdrant ───────────────────────────────────
# Self-hosted (Docker internal, no API key needed):
KNOWLEDGE_QDRANT_URL=http://chatbot_qdrant:6333
KNOWLEDGE_QDRANT_API_KEY=
# Cloud (Qdrant Cloud) — uncomment below and comment above:
# KNOWLEDGE_QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# KNOWLEDGE_QDRANT_API_KEY=your_qdrant_api_key_here
